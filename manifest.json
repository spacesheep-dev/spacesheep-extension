{
  "manifest_version": 3,
  "name": "Move to spacesheep",
  "short_name": "spacesheep",
  "version": "0.1.0",
  "description": "Publish the HTML file or page in this tab to your spacesheep.dev account, with the images and styles beside it.",
  "homepage_url": "https://spacesheep.dev",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Move to spacesheep",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "identity", "storage"],
  "host_permissions": ["https://mcp.spacesheep.dev/*"],
  "commands": {
    "_execute_action": { "description": "Move this page to spacesheep" }
  }
}
