{
  "manifest_version": 3,
  "name": "spacesheep",
  "short_name": "spacesheep",
  "version": "0.3.3",
  "description": "Move pages, pictures, PDFs, videos and files to spacesheep in one click. Each gets its own link, private until you share it.",
  "homepage_url": "https://spacesheep.dev",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Move to spacesheep",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "identity",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "description": "Move this tab to spacesheep"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
